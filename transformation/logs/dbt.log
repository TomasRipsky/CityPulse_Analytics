  create or replace view `project-6c4733db-2f24-496d-90f`.`citypulse_marts_citypulse_staging`.`stg_citibike`
  OPTIONS()
  as -- stg_citibike.sql
-- Vista ligera sobre la tabla raw de Citibike.
-- Filtra timestamps fuera de rango válido que pueden aparecer
-- en datos corruptos del CSV original.

with source as (
    select * from `project-6c4733db-2f24-496d-90f`.`citypulse_staging`.`citibike`
),

-- Primero filtramos en raw antes de convertir a TIMESTAMP
-- para evitar el error "TIMESTAMP value out of allowed range"
filtered as (
    select *
    from source
    where started_at is not null
      and ended_at is not null
      and duration_minutes > 0
      -- Los microsegundos válidos corresponden a fechas entre 2010 y 2030
      and started_at between 1262304000000000 and 1893456000000000
      and ended_at   between 1262304000000000 and 1893456000000000
),

staged as (
    select
        cast(ride_id as string)               as ride_id,
        cast(rideable_type as string)         as rideable_type,
        timestamp_micros(started_at)          as started_at,
        timestamp_micros(ended_at)            as ended_at,
        cast(start_station_name as string)    as start_station_name,
        cast(end_station_name as string)      as end_station_name,
        cast(start_lat as float64)            as start_lat,
        cast(start_lng as float64)            as start_lng,
        cast(end_lat as float64)              as end_lat,
        cast(end_lng as float64)              as end_lng,
        cast(member_casual as string)         as member_casual,
        cast(duration_minutes as float64)     as duration_minutes,
        cast(year as int64)                   as year,
        cast(month as int64)                  as month
    from filtered
)

select * from staged;


