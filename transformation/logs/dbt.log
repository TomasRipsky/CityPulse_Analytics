-- Resumen diario de clima para NYC.
-- Una fila por día con las métricas agregadas desde los datos horarios.

with daily as (
    select
        date,
        location,

        -- Temperatura
        round(avg(temperature_c), 2)    as temp_avg_c,
        round(min(temperature_c), 2)    as temp_min_c,
