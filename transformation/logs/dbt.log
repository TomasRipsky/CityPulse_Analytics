        round(max(wind_speed_kmh), 2)   as wind_max_kmh,

        -- Humedad
        round(avg(humidity_pct), 2)     as humidity_avg_pct

    from `project-6c4733db-2f24-496d-90f`.`citypulse_staging`.`stg_weather`
    group by date, location
)

select * from daily
order by date desc
    );
  
